rules_version = '2';

// Les photos des validations : photos/{jour}/{uid}.jpg.
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{jour}/{fichier} {
      function validationDe(uid) {
        return firestore.exists(/databases/(default)/documents/validations/$(jour + '_' + uid));
      }

      // Chacun dépose sa photo, une image de moins de 4 Mo, et peut la
      // remplacer tant que la validation n'est pas enregistrée.
      allow write: if request.auth != null
        && fichier == request.auth.uid + '.jpg'
        && request.resource != null
        && request.resource.size < 4 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && !validationDe(request.auth.uid);

      // Comme dans BeReal : on ne voit les photos d'un jour qu'après avoir
      // soi-même validé ce jour-là.
      allow read: if request.auth != null && validationDe(request.auth.uid);

      // Suppression du compte.
      allow delete: if request.auth != null && fichier == request.auth.uid + '.jpg';
    }
  }
}
